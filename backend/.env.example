APP_ENV=dev
# Transmitter identity. The password is a credential. KLEAR1 is the dev default only.
KN_SITE_CODE=2809
KN_SENDER_ID=S1F
KN_TRANSMITTER_PASSWORD=KLEAR1
KN_PROCESSING_PORT=2809
KN_FILER_CODE=S1F
KN_PREPARER_PORT=2809
KN_PREPARER_FILER=S1F
# Separate from the 5106 queues.
EXTRACT_OUTBOUND_QUEUE=CBP.OUT.EXTRACT.QUERY
EXTRACT_INBOUND_QUEUE=CBP.IN.EXTRACT.RESPONSE
MQ_MODE=mock
MQ_OUTBOX_DIR=mq_outbox
# MQ_QUEUE_MANAGER=
# MQ_CHANNEL=
# MQ_HOST=
# MQ_PORT=1414
EXTRACT_CALLBACK_SECRET=dev-callback-secret
# Local safety cap. The extract chapter does not state a block size.
EXTRACT_MAX_BODY_RECORDS=50
DATABASE_URL=sqlite:///extract.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/extract
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# Comma-separated browser origins allowed to call the API (none by default; the dev proxy needs none).
# CORS_ORIGINS=https://extract.example.com
